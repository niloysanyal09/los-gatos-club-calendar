# Copy this file to .env and fill in what you have.
# The app runs in DEMO MODE for anything left blank — sample data, demo sign-in.

DATABASE_URL="file:./dev.db"

# App URL (change when deployed)
APP_URL="http://localhost:3000"

# Set to "local" ONLY on the Mac that sends iMessages (the gateway).
# Leave unset on Vercel — hosted sends are queued and drained by the Mac.
JARVIS_IMESSAGE_GATEWAY=""

# --- Anthropic: powers real event discovery + ranking ---
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# --- Google Calendar OAuth ---
# Google Cloud Console -> create project -> enable "Google Calendar API"
# -> OAuth consent screen (External, Testing mode, add your email as test user)
# -> Credentials -> OAuth Client ID (Web app)
#    Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Ticketmaster Discovery API (concerts, big events) ---
# Free key: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=""
